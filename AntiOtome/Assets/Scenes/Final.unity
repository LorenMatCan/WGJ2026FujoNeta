--- !u!1001 &1173197135
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 2010479303}
    m_Modifications:
    - target: {fileID: 7916464271368744969, guid: 9baf1481c77311e848adc28f2c0db215,
        type: 3}
      propertyPath: m_text
      value: 'Se acerca a la pantalla de tu computadora, un crujido se escucha por
        todo el cuarto, puedes ver como saca una mano de la pantalla, te agarra de
        la ropa y te jala tan fuerte que logras entrar a su mundo, te mira desde
        arriba con suficiencia, mientras se glitchea.



'
      objectReference: {fileID: 0}
    - target: {fileID: 7916464272020636815, guid: 9baf1481c77311e848adc28f2c0db215,
        type: 3}
      propertyPath: m_text
      value: "\u2013Es eso \xBFno? solo un juego para ti... diciendo que si a todo...\xBFnisiquiera
        pensaste en las consecuencias?\r\n\r\n\n"
      objectReference: {fileID: 0}
    - target: {fileID: 7916464272205928142, guid: 9baf1481c77311e848adc28f2c0db215,
        type: 3}
      propertyPath: m_text
      value: "\n\n\n\u2013 Quedate conmigo \xBFQuieres? "
      objectReference: {fileID: 0}
    - target: {fileID: 9198966613850991625, guid: 9baf1481c77311e848adc28f2c0db215,
        type: 3}
      propertyPath: m_AnchoredPosition.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 9198966613850991625, guid: 9baf1481c77311e848adc28f2c0db215,
